# ⚠️ SEGURIDAD: GUÍA DE CONFIGURACIÓN PARA PRODUCCIÓN

# ==============================================================================
# PASO 1: SUPABASE - Usa Service Role (para backend) NUNCA la ANON key
# ==============================================================================

# IMPORTANTE: Estas claves NO deben estar en git
# En Railway: Settings → Environment → agregar variables

# URL del proyecto Supabase (Project Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co

# NUNCA uses sb_publishable_ o la anon key aquí
# Usa la Service Role key (Project Settings → API → service_role)
# Esta clave solo debe existir en el backend, NUNCA en frontend o git
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# PASO 2: MERCADO PAGO - Regenera estas claves
# ==============================================================================

# Access Token de MercadoPago (Settings → Credentials)
MERCADOPAGO_ACCESS_TOKEN=APP_...

# Secret para validar webhooks (Settings → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# ==============================================================================
# PASO 3: URLS - Usa solo HTTPS en producción
# ==============================================================================

# Frontend URL (tu dominio público)
FRONTEND_URL=https://santyhogar.com

# Backend URL pública (para webhooks)
PUBLIC_API_URL=https://api.santyhogar.com

# ==============================================================================
# PASO 4: AMBIENTE - Asegurate de que sea 'production'
# ==============================================================================

ENV=production
DEBUG=false  # NUNCA true en producción

# ==============================================================================
# PASO 5: CHECKLIST ANTES DE COMMIT
# ==============================================================================

# ✅ Este archivo (.env.security) solo es GUÍA - NO COMMITEAR .env real
# ✅ En Railway: usar UI de variables de entorno
# ✅ Regenerar SUPABASE_KEY si estuvo expuesta en GitHub
# ✅ Regenerar MERCADOPAGO tokens si estuvieron en logs/git
# ✅ Verificar que FRONTEND_URL sea el dominio correcto
# ✅ No tener emails/teléfonos reales en DEBUG logs

# ==============================================================================
# COMANDOS DE SEGURIDAD
# ==============================================================================

# Limpiar historial de git (si credenciales estuvieron expuestas)
# git filter-branch --force --index-filter \
#   'git rm --cached --force .env backend/.env' \
#   --prune-empty --tag-name-filter cat -- --all

# Verificar que .env está en .gitignore
# grep "\.env" .gitignore
