<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # NO redireccionar si es un archivo real (-f) o directorio (-d)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Excepciones especiales: estos archivos se sirven como están
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^favicon\.ico$ - [L]
  RewriteRule ^manifest\.json$ - [L]
  
  # El resto: React Router
  RewriteRule . /index.html [L]
</IfModule>

# Configurar tipos MIME correctos
<Files "robots.txt">
  AddType text/plain .txt
  Header set Cache-Control "public, max-age=86400"
</Files>

<Files "sitemap.xml">
  AddType application/xml .xml
  Header set Cache-Control "public, max-age=604800"
</Files>

<Files "sitemap-products.xml">
  AddType application/xml .xml
  Header set Cache-Control "public, max-age=604800"
</Files>
